# Use production on every public deployment. Production fails fast unless
# INSTANCE_CODE and a strong SECRET_KEY are configured.
ENVIRONMENT=development

# Leave empty only in development to skip account verification locally.
INSTANCE_CODE=

# Generate a unique random value of at least 32 characters for production.
SECRET_KEY=replace-with-a-long-random-secret

# Required by docker-compose.prod.yml. Point DOMAIN at the VPS before starting.
DOMAIN=trium.example.com
# Use a generated alphanumeric value so it is safe in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-database-password

TIMEZONE=Europe/Warsaw

# Used when running the API outside Docker:
DATABASE_URL=postgresql+psycopg://trium:trium@localhost:5432/trium
CLIENT_ORIGIN=http://localhost:5173
